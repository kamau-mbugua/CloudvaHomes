# Copy to .env for local development. Never commit real secrets — production values come
# from GCP Secret Manager (see infra/gcp/README.md).

NODE_ENV=development
PORT=8080

# Matches docker-compose.yml at the repo root (or a local Postgres with the same role).
DATABASE_URL=postgresql://hodi:hodi@localhost:5432/hodi_dev
# e2e tests erase every table, so they only run against a database named *test*.
TEST_DATABASE_URL=postgresql://hodi:hodi@localhost:5432/hodi_test

# fatal | error | warn | info | debug | trace | silent  (default: debug in dev, info in prod)
LOG_LEVEL=debug

# Comma-separated browser origins allowed by CORS. Empty in production (same-origin via
# Firebase Hosting). Local dev goes through the Vite proxy, so this can stay empty too.
CORS_ORIGINS=

# Swagger UI at /api/docs. Always on outside production; set true to enable in production.
ENABLE_DOCS=

# GCP project id — lets Cloud Logging group log lines by request trace. Optional locally.
GCP_PROJECT_ID=

# ── Auth ──
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Public URL of the web app (used in invitation links)
APP_URL=http://localhost:5173

# ── Personal data at rest ── (ID numbers etc. are encrypted with these; production values
# come from Secret Manager). Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FIELD_ENCRYPTION_KEYS: "keyId:base64key" — to rotate, put a new key FIRST and keep the old ones.
FIELD_ENCRYPTION_KEYS=
# Keys duplicate-detection hashes. Never change it without re-indexing.
FIELD_INDEX_KEY=

# ── M-Pesa (Daraja) ── each organisation's own Daraja keys are entered in the app, not here.
# DARAJA_MODE: simulated (default outside production; fake Daraja, STK pushes "succeed" after a
# few seconds) | live. PUBLIC_API_URL: base URL Safaricom calls back (default APP_URL).
# MPESA_CALLBACK_IPS: comma-separated allow-list (default: Safaricom's published IPs).
DARAJA_MODE=
PUBLIC_API_URL=
MPESA_CALLBACK_IPS=

# ── Files ── STORAGE_DRIVER: local (default outside production; files in STORAGE_DIR) | gcs
# (production; private bucket STORAGE_BUCKET, no keys — uses the service account).
STORAGE_DRIVER=
STORAGE_DIR=.storage
STORAGE_BUCKET=

# ── Messaging ── "log" prints messages to the log instead of sending them (dev/test only)
# SMS_PROVIDER: log | africastalking. AT_USERNAME is "sandbox" for the Africa's Talking
# sandbox; AT_SENDER_ID is an approved alphanumeric sender id (optional).
SMS_PROVIDER=log
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# EMAIL_PROVIDER: log | smtp. The sender must be a domain-authenticated address.
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Hodi <noreply@example.invalid>

# Proxy hops whose X-Forwarded-For is trusted (0 locally, 1 on Cloud Run)
TRUST_PROXY_HOPS=0
