# Hosts come from /opt/hodi/edge/edge.env:
#   prod : APP_HOST=app.kodihub.co.ke  API_HOST=api.kodihub.co.ke   LANDING_HOST=kodihub.co.ke
#   dev  : APP_HOST=dev.kodihub.co.ke  API_HOST=dapi.kodihub.co.ke  LANDING_HOST=landing.kodihub.co.ke
# Let's Encrypt account e-mail (expiry notices) is optional; to add one, put
#   { email you@yourdomain }
# at the top of this file.

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
	encode zstd gzip
}

(api_guard) {
	# Job endpoints are for cron inside the server only. handle blocks are exclusive and
	# tried in order: this one must come first.
	handle /api/v1/internal/* {
		respond 404
	}

	# During a deploy's migration window (scripts/deploy.sh creates the flag). Payment
	# callbacks keep flowing: M-Pesa and banks don't reliably retry.
	@maintenance {
		file {
			root /srv/maintenance
			try_files /on
		}
		not path /api/v1/hooks/*
	}
	handle @maintenance {
		header Retry-After 60
		header Cache-Control no-store
		root * /srv/maintenance
		rewrite * /index.html
		file_server {
			status 503
		}
	}
}

# Web application (app.kodihub.co.ke on prod, dev.kodihub.co.ke on dev)
{$APP_HOST} {
	import security
	import api_guard

	handle /api/* {
		reverse_proxy {$APP_STACK}-api:8080
	}
	handle {
		reverse_proxy {$APP_STACK}-web:8080
	}
}

# Dedicated API host (api.kodihub.co.ke on prod, dapi.kodihub.co.ke on dev)
{$API_HOST} {
	import security
	import api_guard

	handle {
		reverse_proxy {$APP_STACK}-api:8080
	}
}

# Marketing landing page (kodihub.co.ke on prod, landing.kodihub.co.ke on dev)
{$LANDING_HOST} {
	import security

	handle /api/v1/internal/* {
		respond 404
	}
	handle /api/* {
		reverse_proxy {$APP_STACK}-api:8080
	}
	handle {
		root * /srv/landing/current
		try_files {path} {path}.html /index.html
		file_server
	}
}

# Per-VM extras (production: www redirect).
import sites/*.caddy
